# ==========================================
# AZEEORA COSMETICS — Production (Vercel)
# ==========================================
# NEXT_PUBLIC_* vars are baked into the JS bundle at build time.
# These are ALSO set in Vercel Dashboard → Project → Settings → Environment Variables
# (dashboard values override this file for SSR/ISR at runtime).

# API now lives inside this Next.js app (src/app/api)
NEXT_PUBLIC_API_URL=/api

# Site address: set NEXT_PUBLIC_APP_URL in Vercel once the custom domain is live.
# Without it the app uses the Vercel production URL automatically.

NEXT_PUBLIC_APP_NAME="AZEEORA COSMETICS"
